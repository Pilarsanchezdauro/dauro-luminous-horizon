{
  "buildCommand": "npm run build && node scripts/prerender-pages.js && node scripts/prerender-blog.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/grupo-dauro",
      "destination": "/grupo-dauro/index.html"
    },
    {
      "source": "/grupo-dauro/editorial",
      "destination": "/grupo-dauro/editorial/index.html"
    },
    {
      "source": "/grupo-dauro/arte",
      "destination": "/grupo-dauro/arte/index.html"
    },
    {
      "source": "/grupo-dauro/cine",
      "destination": "/grupo-dauro/cine/index.html"
    },
    {
      "source": "/grupo-dauro/ia",
      "destination": "/grupo-dauro/ia/index.html"
    },
    {
      "source": "/servicios",
      "destination": "/servicios/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/contacto",
      "destination": "/contacto/index.html"
    },
    {
      "source": "/portafolio/jose-carrera",
      "destination": "/portafolio/jose-carrera/index.html"
    },
    {
      "source": "/feed.xml",
      "destination": "https://rnrsfzgmgjdzufqrsnhd.supabase.co/functions/v1/generate-rss"
    },
    {
      "source": "/rss.xml",
      "destination": "https://rnrsfzgmgjdzufqrsnhd.supabase.co/functions/v1/generate-rss"
    }
  ],
  "headers": [
    {
      "source": "/og-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
