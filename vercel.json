{
  "buildCommand": "npm run build && node scripts/prerender-pages.js && node scripts/prerender-blog.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/feed.xml",
      "destination": "https://rnrsfzgmgjdzufqrsnhd.supabase.co/functions/v1/generate-rss"
    },
    {
      "source": "/rss.xml",
      "destination": "https://rnrsfzgmgjdzufqrsnhd.supabase.co/functions/v1/generate-rss"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://grupodauro.wpcomstaging.com/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/og-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
