{
        "buildCommand": "npm run build && node scripts/prerender-pages.js && node scripts/prerender-blog.js",
        "outputDirectory": "dist",
        "trailingSlash": false,
        "redirects": [
                  { "source": "/cartas", "destination": "https://tiendaspain.grupodauro.com/shop/cartas-desde-la-otra-orilla-18026", "permanent": false },
                  { "source": "/shop", "destination": "https://tiendaspain.grupodauro.com/shop", "permanent": false },
                  { "source": "/catalogo", "destination": "https://tiendaspain.grupodauro.com/shop", "permanent": false },
                  { "source": "/producto/:path*", "destination": "https://tiendaspain.grupodauro.com/shop", "permanent": false },
                  { "source": "/tienda/producto/:path*", "destination": "https://tiendaspain.grupodauro.com/shop", "permanent": false },
                  { "source": "/generador-portadas", "destination": "/solicitar-portada", "permanent": false }
        ],
        "rewrites": [
                  { "source": "/feed.xml", "destination": "https://rnrsfzgmgjdzufqrsnhd.supabase.co/functions/v1/generate-rss" },
                  { "source": "/rss.xml", "destination": "https://rnrsfzgmgjdzufqrsnhd.supabase.co/functions/v1/generate-rss" },
                  { "source": "/(.*)", "destination": "/index.html" }
        ],
        "headers": [
                  { "source": "/og-(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
        ]
}
